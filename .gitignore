# Project-local secrets & config — NEVER commit these.
.env
.env.*
!.env.example
*.local.env
virturoid.local.env

# Build outputs, generated artifacts & caches
build/
out_*/
.pytest_cache/
__pycache__/
*.pyc
.coverage
htmlcov/

# Generated models / banked policies / meshes (regenerated by the flywheel)
models/
*.npz
*.stl
*.stl.b64
*.step
*.b64

# Logs
*.log
*.err.log
*.out.log

# Local scratch / experiments (not part of the product)
tmp_*.py
render_humanoid.py

# Internal working docs — plans, roadmaps, research dossier, audits, design briefs, demo prep, infra setup.
# Kept LOCAL on purpose: the README (+ root assets/) is the public face; these are our working notes and
# would only clutter the public repo. To publish a specific one, add a negation below the block, e.g.:
#   !docs/virturoid_research_dossier.md
docs/
virturoid_startup_plan.md
AGENTS.md

# Secondary/experimental web UI. The product UI is the desktop app; the documented browser debug surface
# is webapp.py + viewer/ (kept). This newer web UI is kept LOCAL to keep the public repo's "desktop is the
# product" story clean. Its test is excluded too, so a clone's suite never breaks importing an absent module.
webui/
src/virturoid/ui_server.py
tests/test_ui_server.py

# Local agent / tooling config (dev workflow, not product)
.claude/
.claude/settings.local.json

# Virtualenvs
.venv/
venv/
env/

# Editor / OS cruft
.DS_Store
.idea/
.vscode/
*.swp
