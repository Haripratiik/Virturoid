# Project-local secrets & config — NEVER commit these.
.env
.env.*
!.env.example
*.local.env
virturoid.local.env

# Build outputs, generated artifacts & caches
build/
out_*/
.pytest_cache/
__pycache__/
*.pyc
.coverage
htmlcov/

# Generated models / banked policies / meshes (regenerated by the flywheel)
models/*
*.npz
# Keep the trained quad walk policy so the headline walk replays on a fresh clone (no GPU needed)
!models/learned_quadruped.composed.npz
# Keep the 22KB velocity-conditioned policy so nav_learned's closed-loop maze-follow works out-of-the-box
!models/morph_frog_vel.npz
*.stl
*.stl.b64
*.step
*.b64

# Logs
*.log
*.err.log
*.out.log

# Local scratch / experiments (not part of the product)
tmp_*.py
render_humanoid.py

# Internal working docs — plans, roadmaps, research dossier, audits, design briefs, demo prep, infra setup.
# Kept LOCAL on purpose: the README (+ root assets/) is the public face; these are our working notes and
# would only clutter the public repo. To publish a specific one, add a negation below the block, e.g.:
#   !docs/virturoid_research_dossier.md
docs/
virturoid_startup_plan.md
AGENTS.md

# Local agent / tooling config (dev workflow, not product)
.claude/
.claude/settings.local.json

# Frontend (Virturoid Studio) build artifacts
frontend/node_modules/

# Virtualenvs
.venv/
venv/
env/

# Editor / OS cruft
.DS_Store
.idea/
.vscode/
*.swp

# MVP audit hygiene: never ship local run junk on a blind `git add -A`
MUJOCO_LOG.TXT
reports/

# MVP: ship the built Studio UI + a few demo robot packages so a FRESH CLONE can
# actually run the demo. ui_server auto-serves build/ui_verify when ui_workbench
# is absent, so these curated packages appear with zero build. cad/ stays ignored
# (STL/STEP dominate size and the viewport never reads them).
!build/
build/*
!build/ui_verify/
build/ui_verify/*
!build/ui_verify/build_a_dog_robot_that_walks/
!build/ui_verify/build_a_mobile_base_that_delivers_parts_indoors/
!build/ui_verify/hexapod_walk/
!build/ui_verify/arm_sort/
build/ui_verify/*/cad/
