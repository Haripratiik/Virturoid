# Template for Virturoid's project-local config. Copy to `.env` and fill in.
#   cp .env.example .env      (then edit .env — it is gitignored)
# Real environment variables take precedence over this file.

# Which brain to use: off | openai | claude | local | mock
VIRTUROID_LLM_BACKEND=off

# OpenAI / ChatGPT — set VIRTUROID_LLM_BACKEND=openai above, then paste your key below.
OPENAI_API_KEY=
VIRTUROID_OPENAI_MODEL=gpt-4o-mini

# Claude (optional)
# ANTHROPIC_API_KEY=
# VIRTUROID_CLAUDE_MODEL=claude-opus-4-8

# Local model via an OpenAI-compatible endpoint (Ollama / vLLM)
# VIRTUROID_LOCAL_LLM_URL=http://localhost:11434/v1
# VIRTUROID_LOCAL_LLM_MODEL=nemotron-3-nano
# VIRTUROID_LOCAL_LLM_FORMAT=json_object

# Remote GPU box for training (tailscale ssh target), e.g. user@host. Leave blank for CPU-only.
VIRTUROID_GPU_SSH=

# --- Virturoid Studio's CHAT assistant (separate from VIRTUROID_LLM_BACKEND above) ---------------
# VIRTUROID_LLM_BACKEND picks the model that authors robot ANATOMY in the build pipeline.
# These three pick the model behind Studio's free-form chat box. Neither is needed to build a robot:
# describing one in the chat box dispatches a real build with no model running at all.
# VIRTUROID_ASSISTANT_PROVIDER=ollama                  # chat backend ("ollama" is the implemented one)
# VIRTUROID_ASSISTANT_MODEL=llama3.2                   # model tag to ask that provider for
# OLLAMA_HOST=http://127.0.0.1:11434                   # where the Ollama runtime listens
