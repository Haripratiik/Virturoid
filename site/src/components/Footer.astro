---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap bar mono">
    <span class="brand">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
      </svg>
      VIRTUROID · {year}
    </span>
    <span class="line">DOC A-00 · EVERY FIGURE ON THIS PAGE IS A COMMITTED BUILD ARTIFACT · NO MOCKUPS</span>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--rule);
    padding: 26px 0;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    font-size: 10px;
    letter-spacing: 0.16em;
    color: var(--ink-3);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .brand svg {
    color: var(--ember);
  }
</style>
