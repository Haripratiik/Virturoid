---
// Closing CTA. Formspree via PUBLIC_FORM_ENDPOINT (site/.env); honest mailto
// fallback when unset. No fake urgency, no fake counters.
const FORM_ENDPOINT = import.meta.env.PUBLIC_FORM_ENDPOINT ?? "";
---

<section id="access" class="access">
  <div class="wrap inner reveal">
    <p class="kicker"><span class="idx">STATION 07</span> EARLY ACCESS</p>
    <h2>Your first robot is<br /><em>one sentence</em> away.</h2>
    <p class="sub">
      Virturoid is in active development. Local-first — your designs never leave your disk.
      Leave an email, get the first desktop builds.
    </p>
    {
      FORM_ENDPOINT ? (
        <form class="form" action={FORM_ENDPOINT} method="POST">
          <input type="email" name="email" required placeholder="you@lab.dev" aria-label="Email address" class="mono" />
          <button type="submit" class="mono">JOIN THE WAITLIST</button>
        </form>
      ) : (
        <a class="mailto mono" href="mailto:hello@virturoid.dev?subject=Early%20access">
          hello@virturoid.dev ↗
        </a>
      )
    }
    <p class="note mono">RUNS ON YOUR MACHINE · MUJOCO PHYSICS · HONESTY-GATED EXPORTS</p>
  </div>
</section>

<style>
  .access {
    position: relative;
    padding: 140px 0;
    border-top: 1px solid var(--rule);
    background: var(--paper);
    text-align: center;
  }
  /* Halftone footing instead of a glow gradient */
  .access::after {
    content: "";
    position: absolute;
    inset: auto 0 0 0;
    height: 180px;
    background-image: radial-gradient(oklch(0.74 0.16 55 / 0.2) 1px, transparent 1.5px);
    background-size: 13px 13px;
    mask-image: linear-gradient(transparent, black);
    pointer-events: none;
  }
  .kicker {
    justify-content: center;
  }
  .kicker::before {
    display: none;
  }
  h2 {
    font-size: clamp(40px, 6vw, 72px);
    margin-top: 18px;
  }
  .sub {
    max-width: 460px;
    margin: 18px auto 0;
    font-size: 15.5px;
  }
  .form {
    display: flex;
    gap: 0;
    justify-content: center;
    margin-top: 30px;
    flex-wrap: wrap;
  }
  input {
    background: var(--paper-2);
    border: 1px solid var(--rule-strong);
    border-right: none;
    color: var(--ink-1);
    font-size: 13px;
    padding: 14px 16px;
    width: min(320px, 76vw);
    outline: none;
  }
  input:focus {
    border-color: var(--ember);
  }
  button {
    background: var(--ember);
    color: var(--paper);
    border: 1px solid var(--ember);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.12em;
    padding: 14px 22px;
    cursor: pointer;
    transition: filter 0.15s;
  }
  button:hover {
    filter: brightness(1.12);
  }
  .mailto {
    display: inline-block;
    margin-top: 30px;
    font-size: 14px;
    letter-spacing: 0.06em;
    color: var(--ember);
    border: 1px solid var(--ember);
    padding: 14px 26px;
    transition: background 0.15s, color 0.15s;
  }
  .mailto:hover {
    background: var(--ember);
    color: var(--paper);
  }
  .note {
    margin-top: 26px;
    font-size: 10px;
    letter-spacing: 0.18em;
    color: var(--ink-3);
  }
</style>
