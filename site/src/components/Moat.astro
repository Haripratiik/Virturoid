---
import moat from "../data/moat.json";

// USP 3 — THE MOAT: the factory learns. Real flywheel + design-brain output,
// shown as results (banked assets, warm-starts, niche coverage) with zero
// implementation detail. "What it does" is public; "how" is not.
const { flywheel, brain } = moat;
const maxBanked = Math.max(...flywheel.series.map((s) => s.banked));
---

<section id="memory" class="moat">
  <div class="wrap">
    <div class="grid">
      <div class="text reveal">
        <p class="kicker"><span class="idx">STATION 06</span> THE MEMORY</p>
        <h2>Robot №100 is born<br /><em>smarter</em> than robot №1.</h2>
        <p class="sub">
          Every build feeds a memory of bodies, failures, lessons and reusable skills. The next
          robot doesn't start from zero — it warm-starts from the nearest <strong>proven</strong> design
          and inherits everything the factory already learned. We measure that learning, publicly:
        </p>
        <div class="stats">
          <div class="stat">
            <span class="v mono"><span class="count" data-count={brain.archive_coverage}>0</span></span>
            <span class="k mono">design niches illuminated</span>
          </div>
          <div class="stat">
            <span class="v mono"><span class="count" data-count={brain.qd_score} data-decimals="2">0</span></span>
            <span class="k mono">quality-diversity score</span>
          </div>
          <div class="stat">
            <span class="v mono"><span class="count" data-count={brain.provenance_edges}>0</span></span>
            <span class="k mono">warm-start lineage edges</span>
          </div>
          <div class="stat">
            <span class="v mono"><span class="count" data-count={Math.round(brain.positive_fraction * 100)}>0</span>%</span>
            <span class="k mono">of reuses improved the design</span>
          </div>
        </div>
        <p class="secret mono">Implementation? Not on this page. The output is the proof.</p>
      </div>

      <figure class="chart reveal" aria-label={`Banked reusable assets grew from ${flywheel.banked_start} to ${flywheel.banked_end} across ${flywheel.series.length} cycles`}>
        <figcaption class="mono">
          flywheel_compounding.json
          <span class="stamp verdict">{flywheel.compounding ? "COMPOUNDING" : "FLAT"}</span>
        </figcaption>
        <div class="bars">
          {
            flywheel.series.map((s) => (
              <div class="cycle">
                <div class="bar-zone">
                  <div class="bar" style={`--h:${(s.banked / maxBanked) * 100}%`}>
                    <span class="val mono">{s.banked}</span>
                  </div>
                </div>
                <span class="lab mono">cycle {s.cycle}</span>
                <span class={`ws mono ${s.warm_start ? "on" : ""}`}>{s.warm_start ? "warm-start" : "cold"}</span>
              </div>
            ))
          }
        </div>
        <p class="reading mono">banked reusable assets, {flywheel.banked_start} → {flywheel.banked_end} · {Math.round(flywheel.warm_start_fraction * 100)}% of cycles warm-started</p>
      </figure>
    </div>
  </div>
</section>

<style>
  .moat {
    padding: 120px 0;
    background:
      repeating-linear-gradient(0deg, transparent 0 55px, var(--rule) 55px 56px),
      var(--paper-2);
    border-block: 1px solid var(--rule);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
  }
  h2 {
    font-size: clamp(34px, 4.6vw, 56px);
    margin-top: 18px;
  }
  .sub {
    margin-top: 18px;
    font-size: 15.5px;
    max-width: 520px;
  }
  .sub strong {
    color: var(--ink-1);
  }
  .stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-top: 30px;
    border: 1px solid var(--rule-strong);
    background: var(--paper);
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 18px 20px;
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .stat:nth-child(2n) {
    border-right: none;
  }
  .stat:nth-child(n + 3) {
    border-bottom: none;
  }
  .v {
    font-size: 30px;
    font-weight: 700;
    color: var(--ember);
    line-height: 1;
  }
  .k {
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .secret {
    margin-top: 22px;
    font-size: 11.5px;
    letter-spacing: 0.05em;
    color: var(--ink-3);
    border-left: 2px solid var(--ember);
    padding-left: 12px;
  }

  /* Flywheel chart — CSS bars that grow on reveal */
  .chart {
    margin: 0;
    border: 1px solid var(--rule-strong);
    background: var(--paper);
    padding: 18px 20px 16px;
    box-shadow: 20px 20px 0 oklch(0.72 0.12 250 / 0.06);
  }
  figcaption {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--ink-3);
  }
  .verdict {
    color: var(--ok);
    font-size: 10px;
  }
  .bars {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-top: 18px;
  }
  .cycle {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .bar-zone {
    height: 150px;
    display: flex;
    align-items: flex-end;
    border-bottom: 1px solid var(--rule-strong);
  }
  .bar {
    position: relative;
    width: 100%;
    height: var(--h);
    background: repeating-linear-gradient(-45deg, var(--ember) 0 3px, transparent 3px 7px);
    border: 1px solid var(--ember);
    border-bottom: none;
    transform-origin: bottom;
    transform: scaleY(0);
    transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.15s;
  }
  .reveal.in .bar {
    transform: scaleY(1);
  }
  .val {
    position: absolute;
    top: -22px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 13px;
    font-weight: 700;
    color: var(--ink-1);
  }
  .lab {
    font-size: 10.5px;
    color: var(--ink-3);
    letter-spacing: 0.08em;
  }
  .ws {
    font-size: 9.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .ws.on {
    color: var(--agent);
  }
  .reading {
    margin: 16px 0 0;
    font-size: 10.5px;
    letter-spacing: 0.06em;
    color: var(--ink-3);
  }
  @media (prefers-reduced-motion: reduce) {
    .bar {
      transform: scaleY(1);
      transition: none;
    }
  }
  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
